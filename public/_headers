# FreeSeak asset caching (Cloudflare Workers static assets reads this file)
# Hashed build output never changes for a given filename -> cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Brand images have stable names but can be replaced on deploy -> revalidate.
/favicon.svg
  Cache-Control: public, max-age=86400
/og-image.png
  Cache-Control: public, max-age=86400
/og/*
  Cache-Control: public, max-age=86400

# v0.9: the editor's Unicode font pack and OCR engine are large, immutable
# static assets (lazy-loaded once, then cached by the browser).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/ocr/*
  Cache-Control: public, max-age=31536000, immutable
