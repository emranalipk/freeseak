{
  "name": "FreeSeak — free private online tools",
  "short_name": "FreeSeak",
  "description": "Free, privacy-first tools that run entirely in your browser. No files uploaded, no account needed.",
  "start_url": "/",
  "scope": "/",
  "display": "browser",
